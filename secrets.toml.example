# Template for Streamlit Cloud Secrets
# ====================================================================
# This file is documentation, not configuration. Streamlit Cloud does
# NOT read this file from your repo. To configure auth on your live app:
#
#   1. Open your app in Streamlit Cloud
#   2. Three-dot menu → Manage app → ⋯ → Settings → Secrets
#   3. Paste the contents below (with real password hashes) into the
#      Secrets text box and save.
#
# Generate the password_hash values with:  python generate_password_hash.py
# Never commit real password hashes to git.
# ====================================================================

[auth]
# How long a session stays valid without inactivity (minutes).
session_timeout_minutes = 60

# Users live under [auth.users.<username>]. Add as many as you need.
# Roles: viewer / operator / admin
#   viewer   — read-only dashboard
#   operator — viewer + fault injection (drop / corrupt buttons)
#   admin    — operator + audit log + user list

[auth.users.alice]
password_hash = "PASTE_BCRYPT_HASH_HERE"
role = "admin"

[auth.users.bob]
password_hash = "PASTE_BCRYPT_HASH_HERE"
role = "operator"

[auth.users.charlie]
password_hash = "PASTE_BCRYPT_HASH_HERE"
role = "viewer"
